# ════════════════════════════════════════════════════════════════════════════
# ORDER SERVICE - Environment Variables
# Copy this to .env and update with your values
# ════════════════════════════════════════════════════════════════════════════

# Database Configuration
DATABASE_URL=postgresql://user:password@order-db:5432/orderdb

# Service Configuration
APP_NAME=order-service

# Dependent Services URLs (use container names in Docker)
CART_SERVICE_URL=http://cart:8000
PRODUCT_SERVICE_URL=http://product:8000
PAYMENT_SERVICE_URL=http://payment:8000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000
