# ════════════════════════════════════════════════════════════════════════════
# GATEWAY SERVICE - Environment Variables
# Copy this to .env and update with your values
# ════════════════════════════════════════════════════════════════════════════

# Service URLs (use container names in Docker)
AUTH_SERVICE_URL=http://auth:8000
PRODUCT_SERVICE_URL=http://product:8000
CART_SERVICE_URL=http://cart:8000
ORDER_SERVICE_URL=http://order:8000
PAYMENT_SERVICE_URL=http://payment:8000

# JWT Configuration (must match auth-service)
JWT_SECRET_KEY=7dF0qv6MZ8xN2kLp3Rb9Ws4Yt1Hg5JcU

# API Gateway Configuration
APP_NAME=api-gateway
APP_VERSION=1.0.0
DEBUG=false

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Proxy Timeouts (seconds)
PROXY_TIMEOUT=30
PROXY_CONNECT_TIMEOUT=10
