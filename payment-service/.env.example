# ════════════════════════════════════════════════════════════════════════════
# PAYMENT SERVICE - Environment Variables
# Copy this to .env and update with your values
# ════════════════════════════════════════════════════════════════════════════

# Database Configuration
DATABASE_URL=postgresql://user:password@payment-db:5432/paymentdb

# Service Configuration
APP_NAME=payment-service

# Razorpay Configuration (get from https://dashboard.razorpay.com)
# Leave empty to skip payment validation in development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000
